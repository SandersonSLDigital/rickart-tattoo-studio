---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { useTranslations } from '../../i18n/ui';
import { trabalhos } from '../../data/trabalhos';

const lang = 'en' as const;
const t = useTranslations(lang);

const figureIds = ['espartano-aguia', 'bussola', 'itachi', 'onca-flores', 'pomo-de-ouro', 'odin'];
const figureImages = figureIds.map((id) => trabalhos.find((tr) => tr.id === id)!.imagem);
---

<Base lang={lang} page="about" title={t.meta.titleAbout} description={t.meta.descriptionHome}>
  <section class="section about-section">
    <div class="container about-grid">
      <div class="copy">
        <p class="eyebrow">{t.aboutPage.kicker}</p>
        <h1>{t.aboutPage.title}</h1>
        <p class="lede">{t.aboutPage.paragraph1}</p>
        <p>{t.aboutPage.paragraph2}</p>
        <p>{t.aboutPage.paragraph3}</p>
        <blockquote>&ldquo;{t.aboutPage.quote}&rdquo;</blockquote>
        <a class="btn btn-solid" href="https://www.instagram.com/rickarttattoo_fl/" target="_blank" rel="noopener">
          {t.aboutPage.cta}
        </a>
      </div>
      <div class="figures">
        {
          figureImages.map((img, i) => (
            <figure class:list={{ offset: i % 2 === 1 }}>
              <Image
                src={img}
                alt=""
                widths={[300, 500]}
                sizes="(min-width: 860px) 20vw, 44vw"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .about-section {
    padding-block-start: calc(var(--header-h) + var(--section-pad));
  }

  .about-grid {
    display: grid;
    gap: 3rem;
  }

  .copy h1 {
    margin-block: 0.6rem 1.4rem;
  }

  .copy p {
    max-width: 54ch;
  }

  blockquote {
    margin-block: 1.8rem;
    padding-inline-start: 1.1rem;
    border-inline-start: 2px solid var(--ash);
  }

  .figures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }

  .figures figure {
    margin: 0;
    border: 1px solid var(--bone-faint);
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .figures figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .figures .offset {
    margin-top: 2.75rem;
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
    }
  }
</style>
