---
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<Base lang={lang} page="contact" title={t.meta.titleContact} description={t.meta.descriptionHome}>
  <section class="section contact-section">
    <div class="container contact-grid">
      <div class="copy">
        <p class="eyebrow">{t.contactPage.kicker}</p>
        <h1>{t.contactPage.title}</h1>
        <p class="lede">{t.contactPage.subtitle}</p>

        <div class="block">
          <p class="label">{t.contactPage.addressTitle}</p>
          <p class="value">
            {t.contactPage.addressLine1}<br />
            {t.contactPage.addressLine2}
          </p>
          <a class="text-link" href="https://maps.app.goo.gl/CMp4T97fyD5yoC3x6" target="_blank" rel="noopener">
            {t.contactPage.mapsCta} &rarr;
          </a>
        </div>

        <div class="block">
          <p class="label">{t.contactPage.instagramTitle}</p>
          <p class="value">{t.contactPage.instagramSubtitle}</p>
          <a class="btn btn-solid" href="https://www.instagram.com/rickarttattoo_fl/" target="_blank" rel="noopener">
            {t.contactPage.cta}
          </a>
        </div>
      </div>

      <div class="map-frame">
        <iframe
          title="Rick'Art Tattoo Studio — Google Maps"
          src="https://maps.google.com/maps?q=10+Fairway+Drive,+Deerfield+Beach,+FL+33064&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-section {
    padding-block-start: calc(var(--header-h) + var(--section-pad));
  }

  .contact-grid {
    display: grid;
    gap: 3rem;
  }

  .copy h1 {
    margin-block: 0.6rem 1rem;
    max-width: 16ch;
  }

  .lede {
    max-width: 42ch;
  }

  .block {
    margin-top: 2.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--bone-faint);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ash);
    margin-bottom: 0.6rem;
  }

  .value {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--bone-soft);
  }

  .text-link {
    display: inline-block;
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bone);
    border-bottom: 1px solid var(--ash);
    padding-bottom: 0.2rem;
  }

  .text-link:hover {
    border-color: var(--bone);
  }

  .block .btn {
    margin-top: 0.8rem;
  }

  .map-frame {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--bone-faint);
    filter: grayscale(0.55) brightness(0.88) contrast(1.05);
    min-height: 320px;
  }

  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr 1.1fr;
      align-items: start;
    }
  }
</style>
