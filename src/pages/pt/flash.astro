---
import Base from '../../layouts/Base.astro';
import FlashGrid from '../../components/FlashGrid.astro';
import { useTranslations } from '../../i18n/ui';
import { flashPieces } from '../../data/flash';

const lang = 'pt' as const;
const t = useTranslations(lang);
---

<Base lang={lang} page="flash" title={t.meta.titleFlash} description={t.meta.descriptionHome}>
  <section class="section page-head">
    <div class="container">
      <div class="head-row">
        <p class="eyebrow">{t.flashPage.kicker}</p>
        <p class="count">{t.flashPage.countLabel.replace('{n}', String(flashPieces.length))}</p>
      </div>
      <h1>{t.flashPage.title}</h1>
      <p class="lede">{t.flashPage.subtitle}</p>
    </div>
  </section>

  <section class="section grid-section">
    <div class="container">
      <FlashGrid lang={lang} items={flashPieces} gallery="flash-page" />
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block-start: calc(var(--header-h) + var(--section-pad));
    padding-block-end: 2.5rem;
    border-bottom: 1px solid var(--bone-faint);
  }

  .page-head h1 {
    margin-block: 0.6rem 1rem;
  }

  .head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ash);
    margin: 0;
  }

  .lede {
    max-width: 56ch;
  }

  .grid-section {
    padding-block-start: var(--section-pad);
  }
</style>
