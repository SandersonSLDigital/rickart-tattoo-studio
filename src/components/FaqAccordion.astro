---
interface Item {
  q: string;
  a: string;
}

interface Props {
  title: string;
  items: Item[];
}

const { title, items } = Astro.props;
---

<div class="faq-group">
  <h3>{title}</h3>
  <div class="items">
    {
      items.map((item) => (
        <details class="faq-item">
          <summary>
            <span>{item.q}</span>
            <span class="icon" aria-hidden="true"></span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq-group {
    margin-bottom: 3rem;
  }

  .faq-group h3 {
    margin-bottom: 1.2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--bone-faint);
  }

  .faq-item {
    border-bottom: 1px solid var(--bone-faint);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.15rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-body);
    font-size: 1.02rem;
    color: var(--bone);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .icon {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    background: var(--ash);
    transition: transform 0.25s var(--ease);
  }

  .icon::before {
    top: 6px;
    left: 0;
    width: 14px;
    height: 1px;
  }

  .icon::after {
    top: 0;
    left: 6px;
    width: 1px;
    height: 14px;
  }

  .faq-item[open] .icon::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  .faq-item p {
    padding-bottom: 1.3rem;
    max-width: 60ch;
  }
</style>
