---
import { Image, getImage } from 'astro:assets';
import type { FlashPiece } from '../data/flash';
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  items: FlashPiece[];
  gallery: string;
}

const { lang, items, gallery } = Astro.props;
const t = useTranslations(lang);

const withFull = await Promise.all(
  items.map(async (item) => {
    const full = await getImage({ src: item.imagem, width: 1200 });
    return { ...item, fullSrc: full.src };
  })
);
---

<div class="flash-grid">
  {
    withFull.map((item, i) => {
      const ref = String(i + 1).padStart(3, '0');
      const spotlight = (i + 1) % 7 === 0;
      return (
        <figure class:list={['flash-item', { spotlight }]}>
          <button
            type="button"
            class="trigger"
            data-lightbox-trigger
            data-gallery={gallery}
            data-full={item.fullSrc}
            data-caption={`#${ref}`}
            aria-label={`Flash #${ref}`}
          >
            <Image
              src={item.imagem}
              alt=""
              widths={[300, 500, 800]}
              sizes={spotlight ? '(min-width: 1000px) 44vw, 45vw' : '(min-width: 860px) 22vw, 45vw'}
              loading="lazy"
            />
            <span class="ref">#{ref}</span>
            {!item.disponivel && <span class="badge booked">{t.common.flashBooked}</span>}
          </button>
        </figure>
      );
    })
  }
</div>

<style>
  .flash-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }

  .flash-item {
    margin: 0;
  }

  .trigger {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--bone-faint);
    background: var(--ink-raised);
    cursor: pointer;
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }

  .trigger :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .trigger:hover :global(img) {
    transform: scale(1.04);
  }

  .ref {
    position: absolute;
    bottom: 0.6rem;
    left: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    padding: 0.3em 0.55em;
    background: rgba(11, 11, 10, 0.78);
    color: var(--ash);
    border: 1px solid var(--bone-faint);
  }

  .badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.35em 0.6em;
    background: rgba(11, 11, 10, 0.78);
    color: var(--bone-soft);
    border: 1px solid var(--bone-faint);
  }

  @media (min-width: 640px) {
    .flash-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .flash-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.1rem;
    }

    .flash-item.spotlight {
      grid-column: span 2;
    }

    .flash-item.spotlight .trigger {
      aspect-ratio: 8 / 5;
    }
  }
</style>
