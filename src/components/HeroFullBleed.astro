---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  image: ImageMetadata;
}

const { lang, image } = Astro.props;
const t = useTranslations(lang);
const titleLines = t.hero.title.split('\n');
---

<section class="hero">
  <Image
    src={image}
    alt=""
    class="hero-img"
    widths={[640, 1024, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-copy container">
    <p class="eyebrow">{t.hero.kicker}</p>
    <h1>
      {titleLines.map((line, i) => (
        <>
          {line}
          {i < titleLines.length - 1 && <br />}
        </>
      ))}
    </h1>
    <p class="hero-subtitle">{t.hero.subtitle}</p>
    <a class="btn btn-solid" href="https://www.instagram.com/rickarttattoo_fl/" target="_blank" rel="noopener">
      {t.hero.cta}
    </a>
  </div>

  <div class="hero-scroll-cue" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--ink);
  }

  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 30%;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(11, 11, 10, 0.86) 0%,
      rgba(11, 11, 10, 0.32) 38%,
      rgba(11, 11, 10, 0.55) 68%,
      rgba(11, 11, 10, 0.97) 100%
    );
  }

  .hero-copy {
    position: relative;
    padding-block-end: clamp(3.5rem, 9vw, 6rem);
    padding-block-start: calc(var(--header-h) + 2rem);
    max-width: 46rem;
  }

  .hero-copy .eyebrow {
    margin-bottom: 0.9rem;
  }

  .hero-subtitle {
    margin-top: 1.1rem;
    max-width: 34ch;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--bone-soft);
  }

  .hero-copy .btn {
    margin-top: 1.8rem;
  }

  .hero-scroll-cue {
    position: absolute;
    left: var(--gutter);
    bottom: 1.6rem;
    width: 1px;
    height: 46px;
    background: linear-gradient(180deg, transparent, var(--ash) 60%, transparent);
    display: none;
  }

  @media (min-width: 860px) {
    .hero-scroll-cue {
      display: block;
    }
  }
</style>
