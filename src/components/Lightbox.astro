---
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="lightbox" data-lightbox hidden>
  <button class="lb-backdrop" type="button" data-lightbox-close aria-label={t.common.closeLightbox}></button>
  <div class="lb-shell">
    <button class="lb-close" type="button" data-lightbox-close aria-label={t.common.closeLightbox}>&times;</button>
    <button class="lb-nav lb-prev" type="button" data-lightbox-prev aria-label={t.common.prev}>&larr;</button>
    <figure class="lb-figure">
      <img data-lightbox-img src="" alt="" />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
    <button class="lb-nav lb-next" type="button" data-lightbox-next aria-label={t.common.next}>&rarr;</button>
  </div>
</div>

<script>
  type Entry = { full: string; caption: string; trigger: HTMLElement };

  const root = document.querySelector('[data-lightbox]') as HTMLElement | null;
  const img = root?.querySelector('[data-lightbox-img]') as HTMLImageElement | null;
  const caption = root?.querySelector('[data-lightbox-caption]') as HTMLElement | null;
  const closeBtns = root?.querySelectorAll('[data-lightbox-close]');
  const prevBtn = root?.querySelector('[data-lightbox-prev]') as HTMLButtonElement | null;
  const nextBtn = root?.querySelector('[data-lightbox-next]') as HTMLButtonElement | null;

  if (root && img && caption) {
    const galleries = new Map<string, Entry[]>();
    document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]').forEach((trigger) => {
      const gallery = trigger.dataset.gallery ?? 'default';
      const entry: Entry = {
        full: trigger.dataset.full ?? '',
        caption: trigger.dataset.caption ?? '',
        trigger,
      };
      if (!galleries.has(gallery)) galleries.set(gallery, []);
      galleries.get(gallery)!.push(entry);
      trigger.addEventListener('click', () => open(gallery, galleries.get(gallery)!.indexOf(entry)));
    });

    let activeGallery = '';
    let activeIndex = 0;
    let lastFocused: HTMLElement | null = null;

    function show(gallery: string, index: number) {
      const list = galleries.get(gallery);
      if (!list || !list.length) return;
      const clamped = (index + list.length) % list.length;
      activeGallery = gallery;
      activeIndex = clamped;
      const entry = list[clamped];
      img!.src = entry.full;
      img!.alt = entry.caption;
      caption!.textContent = entry.caption;
      const multi = list.length > 1;
      prevBtn?.toggleAttribute('hidden', !multi);
      nextBtn?.toggleAttribute('hidden', !multi);
    }

    function open(gallery: string, index: number) {
      lastFocused = document.activeElement as HTMLElement;
      show(gallery, index);
      root!.hidden = false;
      requestAnimationFrame(() => root!.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
      (root!.querySelector('[data-lightbox-close]') as HTMLElement | null)?.focus();
    }

    function close() {
      root!.classList.remove('is-open');
      document.body.style.overflow = '';
      window.setTimeout(() => {
        root!.hidden = true;
      }, 250);
      lastFocused?.focus();
    }

    closeBtns?.forEach((btn) => btn.addEventListener('click', close));
    prevBtn?.addEventListener('click', () => show(activeGallery, activeIndex - 1));
    nextBtn?.addEventListener('click', () => show(activeGallery, activeIndex + 1));

    document.addEventListener('keydown', (e) => {
      if (root!.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') show(activeGallery, activeIndex + 1);
      if (e.key === 'ArrowLeft') show(activeGallery, activeIndex - 1);
    });
  }
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lb-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 6, 5, 0.94);
    border: 0;
    opacity: 0;
    transition: opacity 0.28s var(--ease);
  }

  .lightbox.is-open .lb-backdrop {
    opacity: 1;
  }

  .lb-shell {
    position: relative;
    z-index: 1;
    width: min(92vw, 1100px);
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.97);
    transition: opacity 0.28s var(--ease), transform 0.28s var(--ease);
  }

  .lightbox.is-open .lb-shell {
    opacity: 1;
    transform: scale(1);
  }

  .lb-figure {
    margin: 0;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .lb-figure img {
    max-height: 78vh;
    max-width: 100%;
    object-fit: contain;
    border: 1px solid var(--bone-faint);
  }

  .lb-figure figcaption {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--bone-soft);
    text-align: center;
    max-width: 60ch;
  }

  .lb-close {
    position: absolute;
    top: -2.75rem;
    right: 0;
    background: none;
    border: 1px solid var(--graphite);
    color: var(--bone);
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(11, 11, 10, 0.6);
    border: 1px solid var(--graphite);
    color: var(--bone);
    width: 2.6rem;
    height: 2.6rem;
    font-size: 1.1rem;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .lb-nav[hidden] {
    display: none;
  }

  .lb-prev {
    left: -0.5rem;
  }

  .lb-next {
    right: -0.5rem;
  }

  @media (min-width: 860px) {
    .lb-prev {
      left: -3.5rem;
    }

    .lb-next {
      right: -3.5rem;
    }
  }
</style>
